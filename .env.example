# Bot credentials — never commit your .env
DISCORD_TOKEN=
CLIENT_ID=
OWNER_IDS=
GUILD_ID=

# Runtime storage: supabase for production; legacy is an explicit rollback mode.
DATABASE_BACKEND=supabase
# Apply schema.sql and runtime.sql, then run db:migrate before startup.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# External Lavalink playback and optional same-process dashboard.
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
WEB_ENABLED=false
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
WEB_URL=
WEB_PORT=3000
PORT=3000
SESSION_SECRET=
NODE_ENV=production
LOG_LEVEL=info

# Optional guild-owned custom emoji markup. Unicode fallback is the target default.
MUSIC_EMOJI_PLAY=
MUSIC_EMOJI_PAUSE=
MUSIC_EMOJI_NEXT=
MUSIC_EMOJI_PREVIOUS=
MUSIC_EMOJI_STOP=
MUSIC_EMOJI_QUEUE=
MUSIC_EMOJI_LOOP=
MUSIC_EMOJI_SHUFFLE=
MUSIC_EMOJI_VOLUME=
MUSIC_EMOJI_MUSIC=
MUSIC_EMOJI_LOADING=
MUSIC_EMOJI_EQUALIZER=
MUSIC_EMOJI_HEART=
LAVALINK_SEARCH_SOURCE=ytsearch
# Comma-separated trusted hosts for direct audio URLs; no credentials/IP literals.
LAVALINK_ALLOWED_URL_HOSTS=

# Optional first-deploy landing page when required configuration is missing.
# No bot/database starts in this mode; health/readiness return 503.
SETUP_MODE=false
# Explicit first-deploy migration; verifies import before bot startup. Disable after success.
MIGRATE_LEGACY_ON_START=false
# Render rolling deploy: / is process liveness while /ready stays 503 during handover.
RUNTIME_HANDOFF=false
